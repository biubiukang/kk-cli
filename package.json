{
  "name": "cli-demo",
  "version": "1.0.0",
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "packageManager": "pnpm@8.6.12",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "publish:cli": "pnpm build && pnpm publish",
    "lint:ts": "eslint --fix",
    "spellcheck": "cspell lint --dot --gitignore --color --cache --show-suggestions \"(packages|apps)/**/*.@(html|js|cjs|mjs|ts|tsx|css|scss|md)\"",
    "commit": "git-cz",
    "prepare": "husky"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-git"
    }
  },
  "devDependencies": {
    "@eslint/js": "9.23.0",
    "@typescript-eslint/eslint-plugin": "8.28.0",
    "commitizen": "4.3.1",
    "commitlint": "19.8.0",
    "cspell": "8.18.1",
    "cz-git": "1.12.0",
    "eslint": "9.23.0",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-unicorn": "^61.0.2",
    "globals": "16.0.0",
    "husky": "9.1.7",
    "turbo": "2.5.0",
    "typescript": "5.8.2",
    "typescript-eslint": "8.28.0"
  }
}